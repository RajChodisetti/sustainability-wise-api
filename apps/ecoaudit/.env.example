# Non-secret API origin used by browser-facing configuration and rewrites.
NEXT_PUBLIC_API_URL=https://api.sustainabilitywise.com.au

# Server-only API origin used by Next.js Route Handlers. Defaults to the public
# origin above when omitted.
INTERNAL_API_URL=https://api.sustainabilitywise.com.au

# Registration is off unless this is explicitly true and a secret is provided.
PORTAL_REGISTRATION_ENABLED=false
ECOAUDIT_REGISTRATION_SECRET=
SOLARSENSE_REGISTRATION_SECRET=
