{
  "name": "sustainability-wise-api",
  "version": "1.0.0",
  "description": "Unified API server for EcoAudit Pro, SolarSense, and Wattwatchers Fleet",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --import tsx/esm src/index.ts",
    "build": "npm run web:build",
    "api:typecheck": "tsc --noEmit",
    "web:dev": "vite --config web/vite.config.ts --host 0.0.0.0",
    "web:build": "vite build --config web/vite.config.ts",
    "web:preview": "vite preview --config web/vite.config.ts --host 0.0.0.0",
    "web:typecheck": "tsc -p web/tsconfig.json --noEmit",
    "admin:create": "node --import tsx/esm scripts/create-admin.ts",
    "onedrive:backfill": "node --import tsx/esm scripts/onedrive-backfill.ts",
    "onedrive:smoke": "node --import tsx/esm scripts/onedrive-photo-smoke.ts",
    "storage:rename-to-names": "node --import tsx/esm scripts/storage-name-migration.ts",
    "smoke:option3": "node --import tsx/esm scripts/option3-smoke.ts",
    "smoke:wattwatchers": "node --import tsx/esm scripts/wattwatchers-smoke.ts",
    "typecheck": "npm run api:typecheck && npm run web:typecheck",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1062.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^9.1.3",
    "@fastify/swagger": "^9.5.0",
    "@fastify/swagger-ui": "^5.2.2",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.3.2",
    "fastify-plugin": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.21.0",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.5",
    "puppeteer-core": "^25.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sharp": "^0.34.5",
    "tsx": "^4.22.4",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.15.21",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.8.3",
    "vite": "^8.0.16"
  }
}
