NODE_ENV=development
PORT=3000

# PostgreSQL — local dev: postgresql://swapi:password@localhost:5432/sw_development
DATABASE_URL=postgresql://swapi:password@localhost:5432/sw_production

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_random_chars
JWT_REFRESH_SECRET=replace_with_64_different_random_chars

# Azure AD — from portal.azure.com app registration
AZURE_CLIENT_ID=your-azure-app-client-id
AZURE_CLIENT_SECRET=your-azure-app-client-secret
AZURE_TENANT_ID=your-azure-tenant-id
ONEDRIVE_USER_EMAIL=user@yourtenant.onmicrosoft.com

# Puppeteer — path to Chromium on server
# Linux (production):   /usr/bin/chromium-browser
# macOS (local dev):    /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
