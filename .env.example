NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
DATABASE_URL=postgres://swapi:CHANGE_ME@localhost:5432/sw_production
JWT_SECRET=CHANGE_ME_run_openssl_rand_hex_32
JWT_REFRESH_SECRET=CHANGE_ME_run_openssl_rand_hex_32
# Set a distinct production secret; JWT_SECRET fallback is rollout compatibility only.
UPLOAD_CAPABILITY_SECRET=CHANGE_ME_run_openssl_rand_hex_32
UPLOAD_CAPABILITY_TTL_SECONDS=900
ALLOW_LEGACY_UNSIGNED_UPLOADS=false
FILE_CAPABILITY_SECRET=CHANGE_ME_run_openssl_rand_hex_32
FILE_CAPABILITY_TTL_SECONDS=300
ALLOW_LEGACY_PUBLIC_FILES=false

# Rollout order is legacy -> dual -> isolated. Configure all three app
# destinations before selecting dual or isolated.
STORAGE_WRITE_MODE=legacy
LOCAL_FILE_STORAGE_ROOT=/var/lib/sustainability-wise-api/uploads
MAX_UPLOAD_BYTES=52428800
STORAGE_PROVIDER=local
SPACES_REGION=syd1
SPACES_ENDPOINT=https://syd1.digitaloceanspaces.com
SPACES_BUCKET=sw-prod-files-syd1
SPACES_ACCESS_KEY_ID=
SPACES_SECRET_ACCESS_KEY=

ECOAUDIT_STORAGE_PROVIDER=local
ECOAUDIT_LOCAL_FILE_STORAGE_ROOT=/var/lib/sustainability-wise-api/ecoaudit
SOLARSENSE_STORAGE_PROVIDER=local
SOLARSENSE_LOCAL_FILE_STORAGE_ROOT=/var/lib/sustainability-wise-api/solarsense
INSTALLHUB_STORAGE_PROVIDER=local
INSTALLHUB_LOCAL_FILE_STORAGE_ROOT=/var/lib/sustainability-wise-api/installhub

ENABLE_API_DOCS=false
PROTECT_API_DOCS=true
ALLOW_LOCAL_BOOTSTRAP=false
ALLOW_LEGACY_BOOTSTRAP_UPSERT=false
ALLOW_LEGACY_SHARED_REGISTRATION_SECRET=false
ECOAUDIT_REGISTRATION_SECRET=
SOLARSENSE_REGISTRATION_SECRET=
INSTALLHUB_REGISTRATION_SECRET=

# Canonical-v2 is enabled and upload revision-CAS is strict in development/QA.
# Production uses the staged values and rollout gates in .env.production.example.
INSTALLHUB_CANONICAL_V2_ENABLED=true
INSTALLHUB_UPLOAD_REVISION_CAS_REQUIRED=true

# InstallHub tax invoices (seller snapshot + AU GST)
IH_INVOICE_SELLER_NAME="Sustainability Wise"
IH_INVOICE_SELLER_ABN=
IH_INVOICE_SELLER_ADDRESS=
IH_INVOICE_SELLER_EMAIL=
IH_INVOICE_DUE_DAYS=14
IH_INVOICE_GST_RATE=0.10

BACKUP_REMOTE_PATH=onedrive:SustainabilityWise/backups
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
ONEDRIVE_USER_EMAIL=
ONEDRIVE_PHOTO_BACKUP_ENABLED=false
ONEDRIVE_PHOTOS_FOLDER=SustainabilityWise/photos
ONEDRIVE_BACKUP_REQUIRED=false
ONEDRIVE_SMOKE_PHOTO_PATH=

# Expo scheduler push delivery. EXPO_ACCESS_TOKEN is optional unless enhanced
# push security is enabled. Its Expo account must access all three EAS projects.
EXPO_PUSH_ENABLED=true
EXPO_ACCESS_TOKEN=
EXPO_PUSH_POLL_INTERVAL_MS=5000
EXPO_PUSH_CLAIM_BATCH_SIZE=25
EXPO_PUSH_STALE_CLAIM_MS=120000
EXPO_PUSH_RECEIPT_DELAY_MS=900000
EXPO_PUSH_RECEIPT_RETRY_MS=300000

# Scheduler commercial ledger. Rates and entered expense values are ex-GST.
SCHEDULER_LABOUR_COST_RATE=75
SCHEDULER_LABOUR_BILLABLE_RATE=150
SCHEDULER_INVOICE_GST_RATE=0.10
SCHEDULER_INVOICE_DUE_DAYS=14
SCHEDULER_INVOICE_SELLER_NAME=Sustainability Wise
# Required to issue when SCHEDULER_INVOICE_GST_RATE is greater than zero.
SCHEDULER_INVOICE_SELLER_ABN=
SCHEDULER_INVOICE_SELLER_ADDRESS=
SCHEDULER_INVOICE_SELLER_EMAIL=
SCHEDULER_BILL_ATTACHMENT_MAX_BYTES=10485760

# Optional self-hosted maps. Blank Photon disables autocomplete/transient
# geocoding; blank OSRM uses deterministic straight-line route estimates when
# jobs already have coordinates. Values are server-side base URLs, for example
# Photon on :2322 and an Australia-only OSRM driving profile on :5000.
SCHEDULER_PHOTON_URL=
SCHEDULER_OSRM_URL=
SCHEDULER_MAP_REQUEST_TIMEOUT_MS=5000
# One Google Maps URL is bounded to 1-4 assigned jobs (up to three waypoints).
SCHEDULER_ROUTE_MAX_STOPS=4

# Scheduler invoice email. Reuse the exact Gmail OAuth values already used by
# the Wattwatchers Fleet monitor; do not create or commit a second credential.
# SMTP_USER/FROM_EMAIL supplies the RFC From header, matching that monitor.
SCHEDULER_INVOICE_EMAIL_ENABLED=false
EMAIL_DELIVERY_METHOD=gmail_api
GMAIL_USER_ID=me
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
SMTP_USER=
FROM_EMAIL=
SCHEDULER_INVOICE_EMAIL_POLL_INTERVAL_MS=5000
SCHEDULER_INVOICE_EMAIL_CLAIM_BATCH_SIZE=5
SCHEDULER_INVOICE_EMAIL_STALE_CLAIM_MS=120000
SCHEDULER_INVOICE_EMAIL_REQUEST_TIMEOUT_MS=20000
SCHEDULER_INVOICE_EMAIL_MAX_ATTEMPTS=5
SCHEDULER_INVOICE_EMAIL_MAX_ATTACHMENT_BYTES=18874368
EXPO_PUSH_REQUEST_TIMEOUT_MS=15000
PUPPETEER_EXECUTABLE_PATH=
