# Server-runtime configuration for the optional EcoSense portal process.
# Copy this file outside the repository, restrict it to the service user, and
# never rename these values with a NEXT_PUBLIC_ prefix.

INTERNAL_API_URL=http://127.0.0.1:3000
# Dedicated loopback port for the standalone Next.js portal.
ECOSENSE_PORTAL_PORT=3210
PORTAL_REGISTRATION_ENABLED=false
# Supply only the app(s) intentionally opened for controlled registration.
# ECOAUDIT_REGISTRATION_SECRET='replace-with-the-ecoaudit-registration-secret'
# SOLARSENSE_REGISTRATION_SECRET='replace-with-the-solarsense-registration-secret'

# Keep the portal checkout isolated from the live API checkout.
ECOSENSE_PORTAL_ROOT=/opt/ecosense-portal/apps/ecoaudit
