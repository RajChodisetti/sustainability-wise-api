# Replace the existing api.sustainabilitywise.com.au block with this shared-host
# configuration. /portal is the stable entry endpoint; the existing /v1 and
# /health API traffic continues to the API through the explicit API handler.
api.sustainabilitywise.com.au {
    encode zstd gzip

    @portal_entry path /portal /portal/
    handle @portal_entry {
        redir * / 308
    }

    @api path /health /v1 /v1/*
    handle @api {
        reverse_proxy 127.0.0.1:3000
    }

    handle {
        reverse_proxy 127.0.0.1:3210
    }
}
