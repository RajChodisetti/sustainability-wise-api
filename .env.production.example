NODE_ENV=production
HOST=127.0.0.1
PORT=3000
PUBLIC_BASE_URL=https://api.yourdomain.com.au

DATABASE_URL=postgres://sw_api:change-me@127.0.0.1:5432/sustainability_wise
JWT_SECRET=change-me-32-byte-random-secret
JWT_REFRESH_SECRET=change-me-different-32-byte-random-secret
# Use a distinct secret; JWT_SECRET fallback exists only for rollback compatibility.
UPLOAD_CAPABILITY_SECRET=change-me-different-32-byte-random-secret
UPLOAD_CAPABILITY_TTL_SECONDS=900
# Temporary rollback bridge for upload URLs issued before signed capabilities.
ALLOW_LEGACY_UNSIGNED_UPLOADS=false
FILE_CAPABILITY_SECRET=change-me-third-32-byte-random-secret
FILE_CAPABILITY_TTL_SECONDS=300
# Temporary rollback bridge only while authenticated mobile builds roll out.
ALLOW_LEGACY_PUBLIC_FILES=false

LOCAL_FILE_STORAGE_ROOT=/var/lib/sustainability-wise-api/uploads
MAX_UPLOAD_BYTES=52428800

# Existing shared destination. Keep it available during migration/backfill.
STORAGE_PROVIDER=spaces
SPACES_REGION=syd1
SPACES_ENDPOINT=https://syd1.digitaloceanspaces.com
SPACES_BUCKET=sw-legacy-files-syd1
SPACES_ACCESS_KEY_ID=change-me-legacy-key
SPACES_SECRET_ACCESS_KEY=change-me-legacy-secret

# Rollout order is legacy -> dual -> isolated.
STORAGE_WRITE_MODE=legacy

# Use a distinct bucket and distinct least-privilege IAM access key for each app.
# dual/isolated production startup rejects duplicate buckets or access-key IDs.
ECOAUDIT_STORAGE_PROVIDER=spaces
ECOAUDIT_SPACES_REGION=syd1
ECOAUDIT_SPACES_ENDPOINT=https://syd1.digitaloceanspaces.com
ECOAUDIT_SPACES_BUCKET=sw-ecoaudit-files-syd1
ECOAUDIT_SPACES_ACCESS_KEY_ID=change-me-ecoaudit-key
ECOAUDIT_SPACES_SECRET_ACCESS_KEY=change-me-ecoaudit-secret

SOLARSENSE_STORAGE_PROVIDER=spaces
SOLARSENSE_SPACES_REGION=syd1
SOLARSENSE_SPACES_ENDPOINT=https://syd1.digitaloceanspaces.com
SOLARSENSE_SPACES_BUCKET=sw-solarsense-files-syd1
SOLARSENSE_SPACES_ACCESS_KEY_ID=change-me-solarsense-key
SOLARSENSE_SPACES_SECRET_ACCESS_KEY=change-me-solarsense-secret

INSTALLHUB_STORAGE_PROVIDER=spaces
INSTALLHUB_SPACES_REGION=syd1
INSTALLHUB_SPACES_ENDPOINT=https://syd1.digitaloceanspaces.com
INSTALLHUB_SPACES_BUCKET=sw-installhub-files-syd1
INSTALLHUB_SPACES_ACCESS_KEY_ID=change-me-installhub-key
INSTALLHUB_SPACES_SECRET_ACCESS_KEY=change-me-installhub-secret

ENABLE_API_DOCS=false
PROTECT_API_DOCS=true
CORS_ORIGINS=
ALLOW_LOCAL_BOOTSTRAP=false
ALLOW_LEGACY_BOOTSTRAP_UPSERT=false
ALLOW_LEGACY_SHARED_REGISTRATION_SECRET=false
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

# Start the API-first rollout with both gates false. Enable canonical-v2 only
# after migration/backfill validation. Keep upload CAS compatibility false until
# the final iOS/portal clients are adopted and the minimum iOS version is
# enforced; then flip it to true under a dated change ticket and strict smoke.
INSTALLHUB_CANONICAL_V2_ENABLED=false
INSTALLHUB_UPLOAD_REVISION_CAS_REQUIRED=false

# Only populate app-specific secrets for a controlled one-off migration, then
# rotate/remove them and leave bootstrap disabled.
ECOAUDIT_REGISTRATION_SECRET=
SOLARSENSE_REGISTRATION_SECRET=
INSTALLHUB_REGISTRATION_SECRET=

AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
ONEDRIVE_USER_EMAIL=
ONEDRIVE_PHOTO_BACKUP_ENABLED=false
ONEDRIVE_PHOTOS_FOLDER=SustainabilityWise/photos
ONEDRIVE_BACKUP_REQUIRED=false

# Optional when Expo enhanced push security is disabled. If supplied, its Expo
# account must access all three EAS projects. Keep it server-side only; never
# expose it through an EXPO_PUBLIC_* variable.
EXPO_PUSH_ENABLED=true
EXPO_ACCESS_TOKEN=
EXPO_PUSH_POLL_INTERVAL_MS=5000
EXPO_PUSH_CLAIM_BATCH_SIZE=25
EXPO_PUSH_STALE_CLAIM_MS=120000
EXPO_PUSH_RECEIPT_DELAY_MS=900000
EXPO_PUSH_RECEIPT_RETRY_MS=300000

# Scheduler commercial ledger. Rates and entered expense values are ex-GST.
SCHEDULER_LABOUR_COST_RATE=75
SCHEDULER_LABOUR_BILLABLE_RATE=150
SCHEDULER_INVOICE_GST_RATE=0.10
SCHEDULER_INVOICE_DUE_DAYS=14
SCHEDULER_INVOICE_SELLER_NAME=Sustainability Wise
SCHEDULER_INVOICE_SELLER_ABN=
SCHEDULER_INVOICE_SELLER_ADDRESS=
SCHEDULER_INVOICE_SELLER_EMAIL=
EXPO_PUSH_REQUEST_TIMEOUT_MS=15000
