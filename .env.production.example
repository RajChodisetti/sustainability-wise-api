NODE_ENV=production
HOST=127.0.0.1
PORT=3000
PUBLIC_BASE_URL=https://api.yourdomain.com.au

DATABASE_URL=postgres://sw_api:change-me@127.0.0.1:5432/sustainability_wise
JWT_SECRET=change-me-32-byte-random-secret
JWT_REFRESH_SECRET=change-me-different-32-byte-random-secret

LOCAL_FILE_STORAGE_ROOT=/var/lib/sustainability-wise-api/uploads
MAX_UPLOAD_BYTES=52428800

# Use "local" for VM disk storage or "spaces" for DigitalOcean Spaces.
STORAGE_PROVIDER=local
SPACES_REGION=syd1
SPACES_ENDPOINT=https://syd1.digitaloceanspaces.com
SPACES_BUCKET=sw-prod-files-syd1
SPACES_ACCESS_KEY_ID=change-me
SPACES_SECRET_ACCESS_KEY=change-me

ENABLE_API_DOCS=false
PROTECT_API_DOCS=true
CORS_ORIGINS=
ALLOW_LOCAL_BOOTSTRAP=true
ALLOW_LOCAL_BOOTSTRAP_ADMIN_ROLE=true
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

REGISTRATION_SECRET=sw-reg-2026-f3a7b9c2d1e4

AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
ONEDRIVE_USER_EMAIL=
ONEDRIVE_PHOTO_BACKUP_ENABLED=false
ONEDRIVE_PHOTOS_FOLDER=SustainabilityWise/photos
ONEDRIVE_BACKUP_REQUIRED=false
